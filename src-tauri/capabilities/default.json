{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://ark.geops.net/*"
        },
        { "url": "https://mainsail.geops.net/*" },
        { "url": "https://faucet-demo.mainsailhq.com/" },
        { "url": "https://faucet-demo.mainsailhq.com/*" },
        { "url": "https://changelly.com/*" },
        { "url": "https://changenow.io/*" },
        { "url": "https://simpleswap.io/*" },
        { "url": "https://stealthex.io/*" },
        { "url": "https://trocador.app/*" },
        { "url": "https://exchange.flashift.app" },
        { "url": "https://exchange.flashift.app/*" },
        { "url": "https://polygonscan.com/*" },
        { "url": "https://basescan.org/*" },
        { "url": "https://etherscan.io/*" },
        { "url": "https://arbiscan.io/*" },
        { "url": "https://optimistic.etherscan.io/*" },
        { "url": "https://bscscan.com/*" },
        { "url": "https://snowtrace.io/*" }
      ]
    },
    "clipboard-manager:allow-write-text",
    "core:window:allow-set-content-protected"
  ]
}
